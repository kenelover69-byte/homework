def gcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a

# Введення даних
num1 = int(input("Введіть перше число: "))
num2 = int(input("Введіть друге число: "))

# Виклик функції та виведення результату
result = gcd(num1, num2)
print(f"Найбільший спільний дільник чисел {num1} і {num2}: {result}")
